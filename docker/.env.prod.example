# Production settings. Copy to docker/.env.prod (git-ignored, chmod 600) and fill in every blank:
#   cp docker/.env.prod.example docker/.env.prod && chmod 600 docker/.env.prod
# Strong random values: scripts/gen-secrets.sh (or scripts\gen-secrets.ps1) prints the ones that are random. Never commit the real file.
# Start:  docker compose --env-file docker/.env.prod --file docker/compose.yaml --file docker/compose.prod.yaml up --build --detach --wait
# The API refuses to start in Production with a development default, a placeholder or a missing value, and lists every problem at once.

# ---------------------------------------------------------------------------------------------------------------------------------
# Domain and reverse proxy (Caddy)

# The apex domain. The API is served at https://api.$DOMAIN and the object storage at https://storage.$DOMAIN: create A (and AAAA) records
# for both pointing at the server before the first start, or Let's Encrypt cannot issue the certificates.
DOMAIN=

# Where Let's Encrypt sends certificate expiry notices.
ACME_EMAIL=

# Addresses or CIDRs (space separated) that may open /admin, e.g. "203.0.113.7 198.51.100.0/24". Everybody else gets a 404. Required.
ADMIN_ALLOWED_IPS=

# The same for the worker endpoints (/api/v1/internal/*), e.g. the machine that runs kombin-workers. Optional: without it only the server
# itself can call them (workers on the same compose network use http://api:8080 and never pass through the proxy).
# INTERNAL_ALLOWED_IPS=

# The compose network's subnet. The API believes X-Forwarded-For only from here (the proxy). Change it only if it clashes with another network.
# BACKEND_SUBNET=172.30.0.0/24

# ---------------------------------------------------------------------------------------------------------------------------------
# Secrets (random: scripts/gen-secrets.sh)

# At least 32 bytes. Signs the access tokens: changing it signs everybody out.
JWT_SIGNING_KEY=

# At least 32 characters. The X-Internal-Key of the worker endpoints.
INTERNAL_API_KEY=

# At least 16 characters. Shared with the vision service (the API's calls to it and its own check).
VISION_INTERNAL_KEY=

# At least 16 characters. Salted into the stored hash of a clicker's IP address. Changing it makes old hashes incomparable with new ones.
OUTBOUND_IP_SALT=

# Database. Only characters that are safe in a connection string (no ; or =): the generated value is letters and digits.
POSTGRES_USER=kombin
POSTGRES_PASSWORD=
POSTGRES_DB=kombin

# Object storage (MinIO). The API uses the same credentials. To use Cloudflare R2 or S3 instead, see docs/deploy.md.
MINIO_ROOT_USER=kombin-app
MINIO_ROOT_PASSWORD=

# The address the phones reach the storage at: https://storage.$DOMAIN (the same host as in DOMAIN). No trailing slash.
STORAGE_PUBLIC_URL=

# ---------------------------------------------------------------------------------------------------------------------------------
# The founder's admin panel (/admin)

ADMIN_EMAIL=
# `scripts/admin-hash.sh` (or .ps1) asks for the password and prints this. Put it in single quotes if the shell complains about $ or +.
ADMIN_PASSWORD_HASH=

# ---------------------------------------------------------------------------------------------------------------------------------
# Legal pages (https://api.$DOMAIN/legal/privacy, /terms, /delete-account). All three are required in Production.

LEGAL_CONTROLLER_NAME=
LEGAL_CONTACT_EMAIL=
LEGAL_ADDRESS=
# Bump it when a legal text changes in a way users should read again; GET /api/v1/legal returns it.
# LEGAL_VERSION=1.0

# ---------------------------------------------------------------------------------------------------------------------------------
# Other

# The contact in the User-Agent of the catalog image downloads (sellers see it). A real e-mail address.
BOT_CONTACT=

# Sign in with Google / Apple: the OAuth client IDs an ID token's audience must match. A provider with none answers 503. Never commit real ones.
# GOOGLE_CLIENT_ID_ANDROID=
# GOOGLE_CLIENT_ID_IOS=
# GOOGLE_CLIENT_ID_WEB=
# APPLE_CLIENT_ID_IOS=
# APPLE_SERVICES_ID=

# Expo access token; only needed when "enhanced push security" is enabled for the Expo project.
# EXPO_ACCESS_TOKEN=

# Outfit narration by Claude (otherwise templates): NARRATION_PROVIDER=Anthropic and a key.
# NARRATION_PROVIDER=Template
# ANTHROPIC_API_KEY=

# Weather for the outfit engine (Open-Meteo, free, no key).
# WEATHER_ENABLED=true

# Background jobs (notifications, sweeps, purges, account deletion). Leave on: account deletion and push delivery depend on them.
# HANGFIRE_ENABLED=true

# Set to true only to look at OpenAPI or /hangfire on purpose (the dashboard then needs the /admin sign-in). Keep it off.
# DIAGNOSTICS_EXPOSE=false

# ---------------------------------------------------------------------------------------------------------------------------------
# Backups (scripts/backup.sh, run by cron on the server; see docs/deploy.md). Read from the environment of the cron line, or from this file.

# One of the two, so a dump never leaves the machine unencrypted:
#   age:     the PUBLIC key (age1...) of a key pair made with `age-keygen`; keep the private key OFF the server (restoring needs it).
#   openssl: a long passphrase (AES-256, PBKDF2); needed again to restore.
# BACKUP_AGE_RECIPIENT=
# BACKUP_PASSPHRASE=

# Where the encrypted dumps go: an S3-compatible bucket (Cloudflare R2: endpoint https://<account>.r2.cloudflarestorage.com). Without a bucket the
# dumps stay in BACKUP_DIR on the server, which is no protection against losing the server.
# BACKUP_S3_BUCKET=
# BACKUP_S3_ENDPOINT=
# BACKUP_S3_PREFIX=kombin/
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=auto

# Local staging folder, and how many days of dumps to keep (here and in the bucket).
# BACKUP_DIR=./backups
# BACKUP_RETENTION_DAYS=7
