# Copy to docker/.env (git-ignored) and fill in the blanks.

# Required. At least 32 bytes with varied characters, e.g.:  openssl rand -base64 48
JWT_SIGNING_KEY=

# Required. Shared secret for internal endpoints (X-Internal-Key header), at least 32 characters, e.g.:  openssl rand -base64 48
INTERNAL_API_KEY=

# Required for the vision service (and the API's calls to it), at least 16 characters; the same value as kombin-vision/.env. E.g.:
# openssl rand -base64 32
VISION_INTERNAL_KEY=

# Local development database credentials. Use only characters that are safe in a connection string (no ; or =).
POSTGRES_USER=kombin
POSTGRES_PASSWORD=kombin_dev_password
POSTGRES_DB=kombin

# Optional overrides
# Salt mixed into the hashed IP stored with each outbound click. Defaults to a Development-only placeholder; required elsewhere.
# OUTBOUND_IP_SALT=
# Expo access token; only needed when "enhanced push security" is enabled for the Expo project.
# EXPO_ACCESS_TOKEN=
# Set to false to run the API without the background jobs (notifications are then neither created nor pushed).
# HANGFIRE_ENABLED=true
# POSTGRES_PORT=5432
# Object storage (MinIO). The defaults are Development-only; the API uses the same credentials.
# MINIO_ROOT_USER=kombin
# MINIO_ROOT_PASSWORD=kombin_dev_minio_password
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001
# The storage address the app reaches (presigned uploads, public images); for a phone on the LAN: http://<your LAN IP>:9000
# STORAGE_PUBLIC_URL=http://localhost:9000
# Host port (loopback only) of the vision service, and its CPU settings.
# VISION_PORT=8092
# VISION_TORCH_THREADS=4
# VISION_MAX_CONCURRENCY=2
# Host port (loopback only) of the optional Metabase service, started with `--profile metabase`.
# METABASE_PORT=3000
# API_PORT=8080
# ASPNETCORE_ENVIRONMENT=Development
# MIGRATE_ON_STARTUP=true
# SEED_ON_STARTUP=true
