<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Kombin.Api</RootNamespace>
    <AssemblyName>Kombin.Api</AssemblyName>
    <!-- Required for the compiler to enforce IDE0005 (unused usings) during build; everything here is internal, so CS1591 never fires. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.EntityFrameworkCore" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded rather than copied to the output so the seed travels with the assembly (tests, Docker image) and needs no path lookup. -->
    <EmbeddedResource Include="Persistence\Seed\dev-catalog.json" LogicalName="Kombin.Api.Persistence.Seed.dev-catalog.json" />
    <EmbeddedResource Include="Persistence\Seed\style-cards.json" LogicalName="Kombin.Api.Persistence.Seed.style-cards.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kombin.Api.Tests" />
    <InternalsVisibleTo Include="Kombin.Api.IntegrationTests" />
  </ItemGroup>

</Project>
