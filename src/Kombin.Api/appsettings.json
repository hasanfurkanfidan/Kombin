{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Database": {
    "MigrateOnStartup": false,
    "SeedOnStartup": false
  },
  "Jwt": {
    "Issuer": "kombin-api",
    "Audience": "kombin-app",
    "SigningKey": "",
    "AccessTokenLifetime": "00:15:00",
    "RefreshTokenLifetime": "30.00:00:00"
  },
  "Authentication": {
    "Google": {
      "ClientIds": []
    },
    "Apple": {
      "ClientIds": []
    }
  },
  "Internal": {
    "ApiKey": ""
  },
  "Outbound": {
    "IpSalt": ""
  },
  "Hangfire": {
    "Enabled": false
  },
  "Expo": {
    "AccessToken": ""
  },
  "Storage": {
    "Endpoint": "",
    "PresignEndpoint": "",
    "Bucket": "",
    "AccessKey": "",
    "SecretKey": "",
    "PublicBaseUrl": "",
    "ForcePathStyle": true
  },
  "Vision": {
    "BaseUrl": "",
    "InternalKey": ""
  },
  "Weather": {
    "Enabled": false
  },
  "Narration": {
    "Provider": "Template"
  },
  "Anthropic": {
    "ApiKey": "",
    "Model": "claude-haiku-5-5"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.DataProtection": "Error",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Fatal",
        "Microsoft.EntityFrameworkCore.Query": "Fatal",
        "Microsoft.EntityFrameworkCore.Update": "Fatal",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  }
}
