{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Database": {
    "MigrateOnStartup": false,
    "SeedOnStartup": false
  },
  "Jwt": {
    "Issuer": "kombin-api",
    "Audience": "kombin-app",
    "SigningKey": "",
    "AccessTokenLifetime": "00:15:00",
    "RefreshTokenLifetime": "30.00:00:00"
  },
  "Authentication": {
    "Google": {
      "ClientIds": []
    },
    "Apple": {
      "ClientIds": []
    }
  },
  "Internal": {
    "ApiKey": ""
  },
  "Outbound": {
    "IpSalt": ""
  },
  "Hangfire": {
    "Enabled": false
  },
  "RateLimits": {
    "Enabled": true,
    "Auth": { "PermitLimit": 10, "WindowSeconds": 300 },
    "Lens": {
      "Anonymous": { "PermitLimit": 20, "WindowSeconds": 3600 },
      "Authenticated": { "PermitLimit": 60, "WindowSeconds": 3600 }
    },
    "Uploads": { "PermitLimit": 60, "WindowSeconds": 3600 },
    "Events": { "PermitLimit": 600, "WindowSeconds": 300 },
    "Go": { "PermitLimit": 120, "WindowSeconds": 60 },
    "Global": { "PermitLimit": 600, "WindowSeconds": 60 }
  },
  "RequestLimits": {
    "DefaultBytes": 10485760,
    "JsonBytes": 1048576
  },
  "Proxy": {
    "TlsTerminated": false,
    "KnownNetworks": [ "172.16.0.0/12" ]
  },
  "Diagnostics": {
    "Expose": false
  },
  "Legal": {
    "Version": "1.0",
    "ControllerName": "",
    "ContactEmail": "",
    "Address": "",
    "PublicBaseUrl": ""
  },
  "Expo": {
    "AccessToken": ""
  },
  "Storage": {
    "Endpoint": "",
    "PresignEndpoint": "",
    "Bucket": "",
    "AccessKey": "",
    "SecretKey": "",
    "PublicBaseUrl": "",
    "ForcePathStyle": true
  },
  "Vision": {
    "BaseUrl": "",
    "InternalKey": ""
  },
  "Weather": {
    "Enabled": false
  },
  "Narration": {
    "Provider": "Template"
  },
  "Anthropic": {
    "ApiKey": "",
    "Model": "claude-haiku-5-5"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.DataProtection": "Error",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Fatal",
        "Microsoft.EntityFrameworkCore.Query": "Fatal",
        "Microsoft.EntityFrameworkCore.Update": "Fatal",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  }
}
