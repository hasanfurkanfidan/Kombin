@{
    var legal = (ViewContext.ViewData.Model as LegalPageModel)?.Legal;
    string Active(string path) => Context.Request.Path.StartsWithSegments(path, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<!doctype html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@(ViewData["Title"] ?? "Kombin") · Kombin</title>
    <style>
        :root { --bg:#fbfbf9; --fg:#1d1d1b; --muted:#66665f; --line:#dcdcd4; --accent:#1f5eff; --card:#ffffff; }
        @@media (prefers-color-scheme: dark) { :root { --bg:#161615; --fg:#ececea; --muted:#a0a09a; --line:#34342f; --accent:#7aa2ff; --card:#1e1e1d; } }
        * { box-sizing: border-box; }
        body { margin:0; font:17px/1.6 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; background:var(--bg); color:var(--fg); }
        header, main, footer { max-width:760px; margin:0 auto; padding:0 16px; }
        header { padding-top:16px; padding-bottom:8px; display:flex; flex-wrap:wrap; gap:8px 18px; align-items:baseline; border-bottom:1px solid var(--line); }
        header strong { font-size:19px; margin-right:auto; }
        header a { color:var(--muted); text-decoration:none; padding:4px 0; }
        header a.active, header a:hover { color:var(--accent); }
        h1 { font-size:28px; line-height:1.25; margin:24px 0 4px; }
        h2 { font-size:21px; margin:32px 0 6px; }
        h3 { font-size:17px; margin:20px 0 4px; }
        p, li { margin:8px 0; }
        a { color:var(--accent); }
        .meta { color:var(--muted); font-size:15px; margin:0 0 16px; }
        .note { background:var(--card); border:1px solid var(--line); border-radius:8px; padding:10px 14px; margin:16px 0; }
        .tablewrap { overflow-x:auto; border:1px solid var(--line); border-radius:8px; background:var(--card); margin:12px 0; }
        table { border-collapse:collapse; width:100%; font-size:15px; }
        th, td { text-align:left; vertical-align:top; padding:8px 10px; border-bottom:1px solid var(--line); }
        tr:last-child td { border-bottom:0; }
        th { color:var(--muted); font-weight:600; }
        footer { color:var(--muted); font-size:14px; padding-top:24px; padding-bottom:40px; }
    </style>
</head>
<body>
<header>
    <strong>Kombin</strong>
    <a href="/legal/privacy" class="@Active("/legal/privacy")">Gizlilik</a>
    <a href="/legal/terms" class="@Active("/legal/terms")">Kullanım koşulları</a>
    <a href="/legal/delete-account" class="@Active("/legal/delete-account")">Hesabı silme</a>
</header>
<main>
    @RenderBody()
</main>
<footer>
    Sürüm @(legal?.Version) · Veri sorumlusu: @(legal?.ControllerNameOrPlaceholder) · <a href="mailto:@(legal?.ContactEmailOrPlaceholder)">@(legal?.ContactEmailOrPlaceholder)</a>
</footer>
</body>
</html>
