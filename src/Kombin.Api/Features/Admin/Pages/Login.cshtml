@page "/admin/login"
@model Kombin.Api.Features.Admin.Pages.LoginModel
@{
    ViewData["Title"] = "Sign in";
}
<h1>Sign in</h1>
<div class="card" style="max-width:520px">
    @if (Model.Error is { } error)
    {
        <div class="flash error" role="alert">@error</div>
    }
    <form method="post">
        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl">
        <label for="email">E-mail</label>
        <input id="email" name="Input.Email" type="email" autocomplete="username" required autofocus>
        <label for="password">Password</label>
        <input id="password" name="Input.Password" type="password" autocomplete="current-password" required>
        <div class="actions"><button class="primary" type="submit">Sign in</button></div>
    </form>
</div>
